    },
    "homepage": "https://github.com/Microsoft/vscode-azuretools/blob/main/azure/README.md",
    "scripts": {
        "build": "tsc -p ./",
        "compile": "tsc -watch -p ./",
        "lint": "eslint --ext .ts .",
        "lint-fix": "eslint --ext .ts . --fix",
        "test": "node ./out/test/runTest.js",
        "package": "npm pack",
        "l10n": "npx @vscode/l10n-dev export --outDir ./l10n ./src"
    },
