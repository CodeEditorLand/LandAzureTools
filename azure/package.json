        "@types/semver": "^7.7.0",
        "@types/uuid": "^10.0.0",
        "@types/vscode": "^1.100.0",
        "@typescript-eslint/eslint-plugin": "^8.33.1",
        "@vscode/test-electron": "^2.5.2",
        "eslint": "^9.28.0",
        "eslint-plugin-import": "^2.31.0",
        "glob": "^11.0.2",
        "mocha": "^11.5.0",
        "mocha-junit-reporter": "^2.2.1",
        "mocha-multi-reporters": "^1.5.1",
