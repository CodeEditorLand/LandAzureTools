        "@azure/arm-storage": "^18.5.0",
        "@azure/arm-storage-profile-2020-09-01-hybrid": "^2.1.0",
        "@azure/core-client": "^1.9.4",
        "@azure/core-rest-pipeline": "^1.20.0",
        "@azure/logger": "^1.2.0",
