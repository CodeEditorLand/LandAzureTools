{
    "name": "@microsoft/vscode-azext-utils",
    "author": "Microsoft Corporation",
    "version": "3.1.2",
    "description": "Common UI tools for developing Azure extensions for VS Code",
    "tags": [
        "azure",
        "vscode"
    ],
    "keywords": [
        "azure",
        "vscode"
    ],
    "main": "out/src/index.js",
    "types": "index.d.ts",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/Microsoft/vscode-azuretools"
    },
    "bugs": {
        "url": "https://github.com/Microsoft/vscode-azuretools/issues"
    },
    "homepage": "https://github.com/Microsoft/vscode-azuretools/blob/main/utils/README.md",
    "scripts": {
        "build": "tsc -p ./",
        "compile": "tsc -watch -p ./",
        "lint": "eslint --ext .ts .",
        "lint-fix": "eslint --ext .ts . --fix",
        "test": "node ./out/test/runTest.js",
        "package": "npm pack",
        "l10n": "npx @vscode/l10n-dev export --outDir ./l10n ./src"
    },
    "dependencies": {
        "@microsoft/vscode-azureresources-api": "^2.5.0",
        "@vscode/extension-telemetry": "^1.0.0",
        "dayjs": "^1.11.13",
        "escape-string-regexp": "^5.0.0",
        "html-to-text": "^9.0.5",
        "semver": "^7.7.2",
        "uuid": "^11.1.0",
        "vscode-tas-client": "^0.1.84",
        "vscode-uri": "^3.1.0"
    },
    "peerDependencies": {
        "@azure/ms-rest-azure-env": "^2.0.0"
    },
    "devDependencies": {
        "@microsoft/eslint-config-azuretools": "^0.2.4",
        "@microsoft/vscode-azext-dev": "^2.1.1",
        "@types/html-to-text": "^9.0.4",
        "@types/mocha": "^10.0.10",
        "@types/node": "^24.0.0",
        "@types/semver": "^7.7.0",
        "@types/uuid": "^10.0.0",
        "@types/vscode": "1.100.0",
        "@typescript-eslint/eslint-plugin": "^8.34.0",
        "@vscode/test-electron": "^2.5.2",
        "eslint": "^9.28.0",
        "eslint-plugin-import": "^2.31.0",
        "glob": "^11.0.2",
        "mocha": "^11.6.0",
        "mocha-junit-reporter": "^2.2.1",
        "mocha-multi-reporters": "^1.5.1",
        "typescript": "^5.8.3"
    }
}
